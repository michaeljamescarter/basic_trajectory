                         "BAS.1724.TP2", "BAS.1716.TP2", "BAS.1840.TP1", "BAS.1884.TP2", 
                         "BAS.1716.TP1", "BAS.1847.TP1", "BAS.2022.TP2", "BAS.1746.TP2",
                         "BAS.1849.TP1", "BAS.1806.TP1", "BAS.1746.TP1", "BAS.1929.TP2",
                         "BAS.2021.TP1", "BAS.1911.TP1", "BAS.1929.TP1", "BAS.1884.TP1", 
