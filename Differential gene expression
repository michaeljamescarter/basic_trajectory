## Building transcript / gene table with Ensembl human index ----------------


edb <- EnsDb.Hsapiens.v86
edb


k <- keys(edb, keytype = "TXNAME")
tx2gene <- transcripts(edb, columns = c("tx_id", "gene_id"))
tx2gene <- data.frame(
  TXNAME = mcols(tx2gene)$tx_id,  # Extract tx_id from metadata
  GENEID = mcols(tx2gene)$gene_id  # Extract gene_id from metadata
)
head(tx2gene)


txi <- tximport(files, type = "salmon", tx2gene = tx2gene, countsFromAbundance="lengthScaledTPM", ignoreTxVersion = TRUE) # Note that this ignores the transcript, and uses lengthscaledTPM, i.e. it accounts for bias in the length of transcripts

# Save counts as data

basic_rnaseq_data <- txi$counts %>%
  round() %>%
  data.frame()


## Annotations

annot <- as.data.frame(genes(edb))
annot <- subset(annot, select = c("gene_id", "gene_name"))


### Create meta data --------------------------------------------------------

sampleTable <- data.frame(timepoint = substr(colnames(basic_rnaseq_data), 10,12))

meta <- data.frame(sampleTable, row.names = colnames(txi$counts))

# Add each patientt as their own control
meta$patientid <- rownames(meta)
meta$patientid <- gsub("\\.TP[12]", "", meta$patientid) %>%
  factor()

meta$timepoint <- factor(meta$timepoint)


patient <- as.data.frame(substr(row.names(meta),1,8))
names(patient)[names(patient) =="substr(row.names(meta), 1, 8)"] <- "basic_id"
patient_data_link <- as.data.frame(cbind(patient$basic_id, meta$timepoint))
names(patient_data_link)[names(patient_data_link) =="V1"] <- "basic_id"
names(patient_data_link)[names(patient_data_link) =="V2"] <- "timepoint"
patient_data_link$timepoint <- as.factor(patient_data_link$timepoint)

### DESeq2 -----------------------------------------------------------------

# Match metadata and counts data - check if match

all(colnames(txi$counts) %in% rownames(meta))
all(colnames(txi$counts) == rownames(meta))

# Create DESeq2Dataset object

ddsTxi <- DESeqDataSetFromTximport(txi, colData = meta, design = ~ patientid +timepoint)

# Keep only rows with more than 10 reads

keep <- rowSums(counts(ddsTxi)) >= 10
dds <- ddsTxi[keep,]

# Run DESeq2

dds <- DESeq(dds)

### Normalization ------------------------------------------------------------


# Retrieve normalized counts matrix

normalized_counts <- counts(dds, normalized=TRUE)

# Save to a file for later use

write.table(normalized_counts, file = "basic_quant/normalized_count.txt", sep = "\t", quote = F, col.names = NA)

# Normalize + Transform counts for PCA data visualization

vsd <- vst(dds, blind = TRUE)
assay_vsd <- assay(vsd)

# Normalize counts for DGE analysis 

# Convert normalized_counts to a dataframe and transfer the row names to a new column

normalized_counts_df <- counts(dds, normalized=T) %>%
  data.frame() %>%
  rownames_to_column(var="gene")

# Merge together (ensembl IDs) the normalized counts data frame w a subset of 
# the annotations in the tx2gene data frame (only the columns for ensembl gene IDs
# and gene symbols)

normalized_counts_df <- merge(normalized_counts_df, annot, by.x="gene", by.y = "gene_id")

# Create a tibble for normalized counts

normalized_counts_df <- normalized_counts_df %>%
  as_tibble()

