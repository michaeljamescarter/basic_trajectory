#### Volcano plot - adapted from https://biostatsquid.com/volcano-plots-r-tutorial/ ------------------

# Obtain logical vector where TRUE values denote padj values>0.05 
# and fold change>1.5 in either direction

res_tableTP_tb <- res_tableTP_tb %>%
  dplyr::mutate(threshold_OE = padj < 0.05 & abs(log2FoldChange) >= 0.5)

# Add a column to specify if UP or DOWN regulated

res_tableTP_tb$diffexpressed <- "NO"
res_tableTP_tb$diffexpressed[res_tableTP_tb$log2FoldChange > 0.5 & res_tableTP_tb$padj < 0.05] <- "UP"
res_tableTP_tb$diffexpressed[res_tableTP_tb$log2FoldChange < -0.5 & res_tableTP_tb$padj < 0.05] <- "DOWN"


# Plot


# Label top significant genes

# Create a new column "delabel" to de, that will contain the name of the top 20 differential expressed genes (NA in case they are not)

res_tableTP_tb$delabel <- ifelse(res_tableTP_tb$gene_name %in% head(res_tableTP_tb[order(res_tableTP_tb$padj), "gene_name"], 20) | abs(res_tableTP_tb$log2FoldChange) > 6, res_tableTP_tb$gene_name, NA)


volcanoplot <- ggplot(data = res_tableTP_tb, aes(x = log2FoldChange, y = -log10(padj), col = diffexpressed, label = delabel)) +
  geom_vline(xintercept = c(-0.5, 0.5), col = "gray", linetype = 'dashed') +
  geom_hline(yintercept = -log10(0.05), col = "gray", linetype = 'dashed') + 
  geom_point(size = 2) +
  xlim(-4,4) +
  scale_color_manual(values = c("#00AFBB", "grey", "red"), 
                     labels = c("Downregulated", "Not significant", "Upregulated")) +
  labs(color = ' ', #legend_title, 
       x = expression("log"[2]*"FoldChange"), y = expression("-log"[10]*"p-value")) + 
  theme(axis.text.x = element_text(size = 12), axis.title.x = element_text(size = 16), axis.title.y = element_text(size = 16), axis.text.y = element_text(size = 12)) +
  theme(
    legend.text = element_text(size = 13)  # <- Increase legend label size
  )+
  #ggtitle('Volcano plot') + # Plot title 
  geom_text_repel(max.overlaps = Inf, size = 6) + # To show all labels +
  theme(legend.position = "top") +
  theme_minimal()

